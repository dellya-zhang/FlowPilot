# Runs without an API key: reproducible mock AI provider
DATABASE_URL=sqlite+aiosqlite:///./agent_platform.db
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
REDIS_URL=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=demoaccess
S3_SECRET_KEY=demosecret
S3_BUCKET=agent-artifacts
ARTIFACT_DIR=./artifacts
CORS_ORIGINS=

# Optional shared deployment token; not tenant authentication
ACCESS_TOKEN=

# Optional DeepSeek: set AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_MAX_TOKENS=600
LLM_MAX_CALLS=18
LLM_BUDGET_CNY=10
LLM_AUDIT_PATH=./artifacts/llm-usage.jsonl

MODEL_CONCURRENCY=4
MAX_ACTIVE_CAMPAIGNS=16
CANDIDATE_TIMEOUT_SECONDS=45
SHUTDOWN_GRACE_SECONDS=5

LEASE_SECONDS=15
RECOVERY_POLL_SECONDS=2

# Optional actual local inference; choose a model already installed in your local server.
# AI_PROVIDER=local
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL_NAME=local-model
LOCAL_MODEL_API_KEY=

SUPPORT_TIMEOUT_SECONDS=90

# Optional ClickHouse projection; Docker Compose supplies these automatically.
CLICKHOUSE_URL=
CLICKHOUSE_DATABASE=flowpilot
CLICKHOUSE_USER=flowpilot
CLICKHOUSE_PASSWORD=flowpilot_local

# Optional S3-compatible image override (default maintained MinIO fork)
S3_IMAGE=docker.io/pgsty/silo:RELEASE.2026-11-12T00-00-00Z

# Runs without an API key: reproducible mock AI provider
DATABASE_URL=sqlite+aiosqlite:///./agent_platform.db
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
REDIS_URL=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=demoaccess
S3_SECRET_KEY=demosecret
S3_BUCKET=agent-artifacts
ARTIFACT_DIR=./artifacts
CORS_ORIGINS=http://localhost:3000

# Optional shared deployment token; not tenant authentication
ACCESS_TOKEN=

# Optional DeepSeek: set AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_MAX_TOKENS=600
LLM_MAX_CALLS=18
LLM_BUDGET_CNY=10
LLM_AUDIT_PATH=./artifacts/llm-usage.jsonl

MODEL_CONCURRENCY=4
MAX_ACTIVE_CAMPAIGNS=16
CANDIDATE_TIMEOUT_SECONDS=45
SHUTDOWN_GRACE_SECONDS=5

LEASE_SECONDS=15
RECOVERY_POLL_SECONDS=2
